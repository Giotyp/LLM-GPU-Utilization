{
  "metadata": {
    "name": "Llama2 Concurrent 1000",
    "description": "1000 concurrent requests with different prompts to test throughput and latency under high load",
    "created": "2025-11-07",
    "version": "1.0"
  },
  "model": {
    "path": "./models/Llama2-7b",
    "name": "Llama2-7b",
    "dtype": "bfloat16",
    "max_seq_length": 2048,
    "tensor_parallel_size": 1
  },
  "server": {
    "port": 8500,
    "gpu_memory_utilization": 0.9,
    "max_num_batched_tokens": 16384,
    "disable_log_requests": true,
    "timeout": 300
  },
  "load_profile": {
    "num_requests": 1000,
    "inter_arrival_lambda": 10.0,
    "seed": 42
  },
  "workload": [
    {
      "id": "question_1",
      "description": "Answer a general knowledge question",
      "messages": [
        {"role": "system", "content": "You are a helpful assistant that answers questions concisely."},
        {"role": "user", "content": "What is the capital of France?"}
      ],
      "max_tokens": 32,
      "weight": 0.2
    },
    {
      "id": "question_2",
      "description": "Answer a technical question",
      "messages": [
        {"role": "system", "content": "You are a helpful assistant that answers questions concisely."},
        {"role": "user", "content": "Explain how GPU memory works in the context of deep learning."}
      ],
      "max_tokens": 64,
      "weight": 0.15
    },
    {
      "id": "code_review",
      "description": "Review a code snippet",
      "messages": [
        {"role": "system", "content": "You are a code reviewer."},
        {"role": "user", "content": "Review this Python function:\n\ndef fibonacci(n):\n    if n <= 1:\n        return n\n    return fibonacci(n-1) + fibonacci(n-2)"}
      ],
      "max_tokens": 48,
      "weight": 0.15
    },
    {
      "id": "summary",
      "description": "Summarize a text",
      "messages": [
        {"role": "system", "content": "You are a text summarization assistant."},
        {"role": "user", "content": "Summarize: GPU profiling is critical for optimizing machine learning workloads. It helps identify bottlenecks in memory utilization and compute throughput."}
      ],
      "max_tokens": 40,
      "weight": 0.15
    },
    {
      "id": "creative_writing",
      "description": "Generate creative content",
      "messages": [
        {"role": "system", "content": "You are a creative writer."},
        {"role": "user", "content": "Write a short haiku about artificial intelligence."}
      ],
      "max_tokens": 32,
      "weight": 0.15
    },
    {
      "id": "list_generation",
      "description": "Generate a list",
      "messages": [
        {"role": "system", "content": "You are a helpful assistant that generates lists."},
        {"role": "user", "content": "List 5 benefits of GPU acceleration in machine learning."}
      ],
      "max_tokens": 80,
      "weight": 0.12
    },
    {
      "id": "explanation",
      "description": "Explain a concept",
      "messages": [
        {"role": "system", "content": "You are an educator."},
        {"role": "user", "content": "Explain the concept of batching in neural network inference."}
      ],
      "max_tokens": 64,
      "weight": 0.08
    }
  ]
}
